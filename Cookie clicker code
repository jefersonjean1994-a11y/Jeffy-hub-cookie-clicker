// ==UserScript==
// @name         Jeffy Hub - Cookie Clicker
// @namespace    JeffyHub
// @version      1.0.0
// @description  Jeffy Hub for Cookie Clicker
// @author       Jeffy
// @match        https://orteil.dashnet.org/cookieclicker/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==

(() => {
    "use strict";

    const KEY = "jeffyisgoat";

    const state = {
        unlocked: false,
        autoClick: false,
        free: false,
        autoBuy: false,
        heavenly: false,
        menuKey: "p",
        clickKey: "c",
        freeKey: "f",
        buyKey: "b",
        heavenlyKey: "h",
        destroyed: false
    };

    // -----------------------------
    // Remove old Jeffy Hub
    // -----------------------------

    document.querySelectorAll(
        "#jeffyHub,#jeffyKeyOverlay,#jeffyStyle"
    ).forEach(e => e.remove());

    // -----------------------------
    // CSS
    // -----------------------------

    const css = document.createElement("style");
    css.id = "jeffyStyle";

    css.textContent = `
        #jeffyKeyOverlay {
            position:fixed;
            inset:0;
            z-index:999999999;
            display:flex;
            justify-content:center;
            align-items:center;
            background:rgba(0,0,0,.82);
            backdrop-filter:blur(10px);
            font-family:Arial,sans-serif;
        }

        #jeffyKeyBox {
            width:400px;
            padding:35px;
            text-align:center;
            background:rgba(8,8,12,.94);
            border:1px solid #c54cff;
            border-radius:24px;
            box-shadow:
                0 0 25px #8d20b5,
                0 0 70px rgba(170,30,255,.35);
        }

        #jeffyKeyTitle {
            font-size:42px;
            font-weight:bold;
            color:#df7cff;
            text-shadow:0 0 15px #b020ff;
            margin-bottom:10px;
        }

        #jeffyKeyBox input {
            width:100%;
            box-sizing:border-box;
            padding:14px;
            border-radius:10px;
            border:1px solid #7d2b99;
            background:#08080c;
            color:white;
            outline:none;
            text-align:center;
            margin-top:20px;
        }

        #jeffyUnlock {
            width:100%;
            padding:14px;
            margin-top:12px;
            border:0;
            border-radius:10px;
            background:linear-gradient(90deg,#6d168c,#c329ff);
            color:white;
            font-weight:bold;
            cursor:pointer;
        }

        #jeffyKeyStatus {
            margin-top:12px;
            min-height:20px;
        }

        #jeffyHub {
            position:fixed;
            width:620px;
            height:620px;
            left:50%;
            top:50%;
            transform:translate(-50%,-50%);
            z-index:999999998;
            overflow:hidden;
            color:white;
            font-family:Arial,sans-serif;
            border:1px solid rgba(215,80,255,.75);
            border-radius:26px;

            background:
                linear-gradient(
                    rgba(0,0,0,.55),
                    rgba(8,0,14,.68)
                ),
                url("https://gifdb.com/images/high/emo-sad-anime-boy-f50spxut94yn7c9o.gif");

            background-size:cover;
            background-position:center;

            box-shadow:
                0 0 25px rgba(190,40,255,.65),
                0 0 80px rgba(120,20,170,.38);
        }

        #jeffyHub.hidden {
            display:none!important;
        }

        #jeffyHeader {
            height:82px;
            display:flex;
            align-items:center;
            justify-content:space-between;
            padding:0 22px;
            box-sizing:border-box;
            background:rgba(0,0,0,.48);
            border-bottom:1px solid rgba(210,80,255,.42);
            user-select:none;
        }

        #jeffyTitle {
            font-size:40px;
            font-weight:900;
            color:#e18aff;
            text-shadow:
                0 0 8px #a020f0,
                0 0 22px #a020f0;
        }

        #jeffyClose {
            width:42px;
            height:42px;
            border:1px solid #ff416d;
            border-radius:10px;
            background:#17050b;
            color:#ff5475;
            font-size:27px;
            cursor:pointer;
        }

        #jeffyTabs {
            display:flex;
            gap:8px;
            padding:10px;
            background:rgba(0,0,0,.4);
        }

        .jeffyTab {
            flex:1;
            padding:12px;
            border:1px solid #542060;
            border-radius:10px;
            background:rgba(0,0,0,.55);
            color:#999;
            font-weight:bold;
            cursor:pointer;
        }

        .jeffyTab.active {
            color:white;
            border-color:#d04cff;
            background:#64127c;
            box-shadow:0 0 15px rgba(210,60,255,.4);
        }

        #jeffyContent {
            height:455px;
            box-sizing:border-box;
            padding:16px;
            overflow-y:auto;
        }

        .jeffyFeature {
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap:15px;
            padding:15px;
            margin-bottom:10px;
            border:1px solid rgba(190,60,230,.32);
            border-radius:14px;
            background:rgba(3,3,6,.62);
        }

        .jeffyFeature b {
            display:block;
            font-size:18px;
        }

        .jeffyFeature small {
            color:#999;
        }

        .jeffyToggle {
            min-width:65px;
            padding:9px;
            border:1px solid #444;
            border-radius:20px;
            background:#090909;
            color:#777;
            font-weight:bold;
            cursor:pointer;
        }

        .jeffyToggle.on {
            color:white;
            border-color:#dc55ff;
            background:linear-gradient(90deg,#701d90,#c51eff);
            box-shadow:0 0 12px rgba(210,50,255,.4);
        }

        .jeffyKeyButton {
            min-width:70px;
            padding:9px;
            border:1px solid #8734a4;
            border-radius:9px;
            background:#09090d;
            color:#dc7cff;
            cursor:pointer;
        }

        #jeffyListening {
            text-align:center;
            padding:12px;
            color:#999;
        }

        #jeffyDestroy {
            padding:10px 14px;
            border:1px solid #ff315d;
            border-radius:9px;
            background:#20040b;
            color:#ff5475;
            cursor:pointer;
            font-weight:bold;
        }
    `;

    document.head.appendChild(css);

    // -----------------------------
    // Key GUI
    // -----------------------------

    const keyGUI = document.createElement("div");
    keyGUI.id = "jeffyKeyOverlay";

    keyGUI.innerHTML = `
        <div id="jeffyKeyBox">
            <div id="jeffyKeyTitle">☠ JEFFY HUB</div>
            <div>Enter the access key</div>

            <input
                id="jeffyKeyInput"
                type="password"
                placeholder="ACCESS KEY"
            >

            <button id="jeffyUnlock">
                UNLOCK
            </button>

            <div id="jeffyKeyStatus"></div>
        </div>
    `;

    document.body.appendChild(keyGUI);

    const input =
        document.getElementById("jeffyKeyInput");

    const status =
        document.getElementById("jeffyKeyStatus");

    function unlock() {
        if (input.value !== KEY) {
            status.textContent = "✕ WRONG KEY";
            status.style.color = "#ff456b";
            input.value = "";
            return;
        }

        status.textContent = "✓ ACCESS GRANTED";
        status.style.color = "#df7cff";

        setTimeout(() => {
            keyGUI.remove();
            createHub();
        }, 300);
    }

    document
        .getElementById("jeffyUnlock")
        .onclick = unlock;

    input.addEventListener("keydown", e => {
        if (e.key === "Enter") unlock();
    });

    // -----------------------------
    // Create Hub
    // -----------------------------

    function createHub() {
        if (state.destroyed) return;

        const hub = document.createElement("div");
        hub.id = "jeffyHub";

        hub.innerHTML = `
            <div id="jeffyHeader">
                <div id="jeffyTitle">JEFFY HUB</div>
                <button id="jeffyClose">×</button>
            </div>

            <div id="jeffyTabs">
                <button class="jeffyTab active" data-tab="farm">
                    🌑 FARM
                </button>

                <button class="jeffyTab" data-tab="settings">
                    ⚙ SETTINGS
                </button>
            </div>

            <div id="jeffyContent">

                <div id="jeffyFarm">

                    <div class="jeffyFeature">
                        <div>
                            <b>🍪 OP Auto Click</b>
                            <small>Fast automatic clicking</small>
                        </div>
                        <button class="jeffyToggle" id="autoClick">
                            OFF
                        </button>
                    </div>

                    <div class="jeffyFeature">
                        <div>
                            <b>💰 0 Cost Buildings</b>
                            <small>Make buildings cost 0</small>
                        </div>
                        <button class="jeffyToggle" id="free">
                            OFF
                        </button>
                    </div>

                    <div class="jeffyFeature">
                        <div>
                            <b>🛒 Auto Buy</b>
                            <small>Automatically buy buildings</small>
                        </div>
                        <button class="jeffyToggle" id="autoBuy">
                            OFF
                        </button>
                    </div>

                    <div class="jeffyFeature">
                        <div>
                            <b>♾️ Infinite Heavenly Chips</b>
                            <small>Set Heavenly Chips to Infinity</small>
                        </div>
                        <button class="jeffyToggle" id="heavenly">
                            OFF
                        </button>
                    </div>

                    <div class="jeffyFeature">
                        <div>
                            <b>⭐ Cursor Level 10,000</b>
                            <small>Set Cursor level to 10000</small>
                        </div>
                        <button class="jeffyToggle on" id="cursor">
                            ON
                        </button>
                    </div>

                    <div class="jeffyFeature">
                        <div>
                            <b>🏪 Bakery Name</b>
                            <small>Jeffy's Bakery</small>
                        </div>
                    </div>

                    <div class="jeffyFeature">
                        <div>
                            <b>🗑 Destroy Hub</b>
                            <small>Disable everything and remove hub</small>
                        </div>
                        <button id="jeffyDestroy">
                            DESTROY
                        </button>
                    </div>

                </div>

                <div id="jeffySettings" style="display:none">

                    <div class="jeffyFeature">
                        <span>Menu Key</span>
                        <button class="jeffyKeyButton" data-key="menu">
                            P
                        </button>
                    </div>

                    <div class="jeffyFeature">
                        <span>Auto Click Key</span>
                        <button class="jeffyKeyButton" data-key="click">
                            C
                        </button>
                    </div>

                    <div class="jeffyFeature">
                        <span>Free Key</span>
                        <button class="jeffyKeyButton" data-key="free">
                            F
                        </button>
                    </div>

                    <div class="jeffyFeature">
                        <span>Auto Buy Key</span>
                        <button class="jeffyKeyButton" data-key="buy">
                            B
                        </button>
                    </div>

                    <div class="jeffyFeature">
                        <span>Heavenly Chips Key</span>
                        <button class="jeffyKeyButton" data-key="heavenly">
                            H
                        </button>
                    </div>

                    <div id="jeffyListening">
                        Click a key to change its keybind.
                    </div>

                </div>

            </div>
        `;

        document.body.appendChild(hub);

        let listeningFor = null;

        function toggle(id, value) {
            const btn =
                document.getElementById(id);

            btn.textContent =
                value ? "ON" : "OFF";

            btn.classList.toggle("on", value);
        }

        // -----------------------------
        // Free buildings
        // -----------------------------

        function makeFree() {
            if (!window.Game || !Game.ObjectsById) return;

            for (
                let i = 0;
                i < Game.ObjectsById.length;
                i++
            ) {
                const building =
                    Game.ObjectsById[i];

                if (!building) continue;

                building.price = 0;
                building.basePrice = 0;
                building.priceL = 0;
            }

            if (typeof Game.RefreshStore === "function") {
                Game.RefreshStore();
            }
        }

        // -----------------------------
        // Auto Buy
        // -----------------------------

        function buyBuildings() {
            if (!window.Game || !Game.ObjectsById) return;

            for (
                let i = 0;
                i < Game.ObjectsById.length;
                i++
            ) {
                const building =
                    Game.ObjectsById[i];

                if (
                    building &&
                    typeof building.buy === "function"
                ) {
                    try {
                        building.buy();
                    } catch {}
                }
            }
        }

        // -----------------------------
        // Heavenly Chips
        // -----------------------------

        function infiniteHeavenly() {
            if (!window.Game) return;

            Game.heavenlyChips = Infinity;
            Game.heavenlyChipsSpent = 0;

            if (!Game.prestige) {
                Game.prestige = {};
            }

            Game.prestige["Heavenly chips"] =
                Infinity;

            Game.prestige.ready = 1;
            Game.recalculateGains = 1;

            const display =
                document.querySelector(
                    "#ascendHCs .heavenly"
                );

            if (display) {
                display.textContent = "∞";
            }
        }

        // -----------------------------
        // Cursor
        // -----------------------------

        function cursorLevel() {
            if (
                !window.Game ||
                !Game.ObjectsById ||
                !Game.ObjectsById[0]
            ) return;

            Game.ObjectsById[0].level = 10000;

            const level =
                document.getElementById(
                    "productLevel0"
                );

            if (level) {
                level.textContent = "lvl 10000";
            }
        }

        // -----------------------------
        // Bakery name
        // -----------------------------

        function bakeryName() {
            const name =
                document.getElementById("bakeryName");

            if (name) {
                name.textContent =
                    "Jeffy's Bakery";
            }
        }

        // -----------------------------
        // Buttons
        // -----------------------------

        document.getElementById("autoClick").onclick =
            () => {
                state.autoClick =
                    !state.autoClick;

                toggle(
                    "autoClick",
                    state.autoClick
                );
            };

        document.getElementById("free").onclick =
            () => {
                state.free = !state.free;

                toggle("free", state.free);

                if (state.free) {
                    makeFree();
                }
            };

        document.getElementById("autoBuy").onclick =
            () => {
                state.autoBuy =
                    !state.autoBuy;

                toggle(
                    "autoBuy",
                    state.autoBuy
                );
            };

        document.getElementById("heavenly").onclick =
            () => {
                state.heavenly =
                    !state.heavenly;

                toggle(
                    "heavenly",
                    state.heavenly
                );

                if (state.heavenly) {
                    infiniteHeavenly();
                }
            };

        document.getElementById("cursor").onclick =
            cursorLevel;

        // -----------------------------
        // Close
        // -----------------------------

        document.getElementById("jeffyClose").onclick =
            () => {
                hub.classList.add("hidden");
            };

        // -----------------------------
        // Tabs
        // -----------------------------

        hub.querySelectorAll(".jeffyTab")
            .forEach(tab => {

                tab.onclick = () => {

                    hub.querySelectorAll(
                        ".jeffyTab"
                    ).forEach(t =>
                        t.classList.remove("active")
                    );

                    tab.classList.add("active");

                    const farm =
                        document.getElementById(
                            "jeffyFarm"
                        );

                    const settings =
                        document.getElementById(
                            "jeffySettings"
                        );

                    if (
                        tab.dataset.tab === "farm"
                    ) {
                        farm.style.display = "block";
                        settings.style.display = "none";
                    } else {
                        farm.style.display = "none";
                        settings.style.display = "block";
                    }
                };
            });

        // -----------------------------
        // Keybind changing
        // -----------------------------

        hub.querySelectorAll(".jeffyKeyButton")
            .forEach(button => {

                button.onclick = () => {

                    listeningFor =
                        button.dataset.key;

                    document.getElementById(
                        "jeffyListening"
                    ).textContent =
                        "Press the new key...";
                };
            });

        // -----------------------------
        // Destroy
        // -----------------------------

        document.getElementById("jeffyDestroy").onclick =
            () => {

                state.destroyed = true;

                state.autoClick = false;
                state.free = false;
                state.autoBuy = false;
                state.heavenly = false;

                hub.remove();

                css.remove();

                document.removeEventListener(
                    "keydown",
                    keyboardHandler
                );

                if (window.JeffyHub) {
                    delete window.JeffyHub;
                }
            };

        // -----------------------------
        // Keyboard
        // -----------------------------

        function keyboardHandler(e) {

            if (state.destroyed) return;

            if (
                e.target &&
                (
                    e.target.tagName === "INPUT" ||
                    e.target.tagName === "TEXTAREA"
                )
            ) {
                return;
            }

            const key =
                e.key.toLowerCase();

            if (listeningFor) {

                if (listeningFor === "menu")
                    state.menuKey = key;

                if (listeningFor === "click")
                    state.clickKey = key;

                if (listeningFor === "free")
                    state.freeKey = key;

                if (listeningFor === "buy")
                    state.buyKey = key;

                if (listeningFor === "heavenly")
                    state.heavenlyKey = key;

                const button =
                    hub.querySelector(
                        `[data-key="${listeningFor}"]`
                    );

                if (button) {
                    button.textContent =
                        key.toUpperCase();
                }

                document.getElementById(
                    "jeffyListening"
                ).textContent =
                    "Key changed to " +
                    key.toUpperCase();

                listeningFor = null;

                return;
            }

            if (key === state.menuKey) {
                hub.classList.toggle("hidden");
            }

            if (key === state.clickKey) {
                state.autoClick =
                    !state.autoClick;

                toggle(
                    "autoClick",
                    state.autoClick
                );
            }

            if (key === state.freeKey) {
                state.free =
                    !state.free;

                toggle(
                    "free",
                    state.free
                );

                if (state.free) {
                    makeFree();
                }
            }

            if (key === state.buyKey) {
                state.autoBuy =
                    !state.autoBuy;

                toggle(
                    "autoBuy",
                    state.autoBuy
                );
            }

            if (key === state.heavenlyKey) {
                state.heavenly =
                    !state.heavenly;

                toggle(
                    "heavenly",
                    state.heavenly
                );

                if (state.heavenly) {
                    infiniteHeavenly();
                }
            }
        }

        document.addEventListener(
            "keydown",
            keyboardHandler
        );

        // -----------------------------
        // Main loop
        // -----------------------------

        const loop =
            setInterval(() => {

                if (state.destroyed) {
                    clearInterval(loop);
                    return;
                }

                bakeryName();
                cursorLevel();

                if (state.free)
                    makeFree();

                if (state.autoBuy)
                    buyBuildings();

                if (state.heavenly)
                    infiniteHeavenly();

            }, 100);

        // -----------------------------
        // Auto Click
        // -----------------------------

        const clickLoop =
            setInterval(() => {

                if (
                    state.destroyed ||
                    !state.autoClick
                ) {
                    return;
                }

                const cookie =
                    document.getElementById(
                        "bigCookie"
                    );

                if (!cookie) return;

                for (
                    let i = 0;
                    i < 20;
                    i++
                ) {
                    try {
                        cookie.click();
                    } catch {}
                }

            }, 1);

        // -----------------------------
        // Public destroy
        // -----------------------------

        window.JeffyHub = {
            destroy() {
                state.destroyed = true;

                clearInterval(loop);
                clearInterval(clickLoop);

                hub.remove();
                css.remove();

                if (keyGUI)
                    keyGUI.remove();
            }
        };
    }

})();
