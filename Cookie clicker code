    `;

    document.head.appendChild(style);

    // ==========================================
    // KEY SCREEN
    // ==========================================

    const overlay = document.createElement("div");
    overlay.id = "jeffyKeyOverlay";

    overlay.innerHTML = `
        <div id="jeffyKeyBox">

            <div class="jeffyKeySkull">
                ☠️
            </div>

            <div class="jeffyKeyTitle">
                JEFFY HUB
            </div>

            <div class="jeffyKeySub">
                ENTER ACCESS KEY
            </div>

            <input
                id="jeffyKeyInput"
                type="password"
                autocomplete="off"
                placeholder="ACCESS KEY"
            >

            <button id="jeffyUnlock">
                UNLOCK
            </button>

            <div id="jeffyKeyStatus"></div>

        </div>
    `;

    document.body.appendChild(overlay);

    const keyInput =
        document.getElementById("jeffyKeyInput");

    const unlockButton =
        document.getElementById("jeffyUnlock");

    const keyStatus =
        document.getElementById("jeffyKeyStatus");

    function unlock() {
        if (keyInput.value !== CONFIG.key) {

            keyStatus.style.color = "#ff456b";
            keyStatus.textContent = "✕ WRONG KEY";

            keyInput.value = "";

            return;
        }

        keyStatus.style.color = "#df7cff";
        keyStatus.textContent = "✓ ACCESS GRANTED";

        setTimeout(() => {
            overlay.remove();
            createHub();
        }, 350);
    }

    unlockButton.onclick = unlock;

    keyInput.addEventListener(
        "keydown",
        e => {
            if (e.key === "Enter") {
                unlock();
            }
        }
    );

    keyInput.focus();

    // ==========================================
    // CREATE HUB
    // ==========================================

    function createHub() {

        if (state.destroyed) return;

        const hub =
            document.createElement("div");

        hub.id = "jeffyHub";

        hub.innerHTML = `
            <div id="jeffyHeader">

                <div id="jeffyTitle">
                    JEFFY HUB
                </div>

                <button id="jeffyClose">
                    ×
                </button>

            </div>

            <div id="jeffyTabs">

                <button
                    class="jeffyTab active"
                    data-tab="farm"
                >
                    🌑 FARM
                </button>

                <button
                    class="jeffyTab"
                    data-tab="settings"
                >
                    ⚙ SETTINGS
                </button>

            </div>

            <div id="jeffyContent">

                <div id="jeffyFarm">

                    <div class="jeffyFeature">
                        <div>
                            <b>🍪 OP Auto Click</b>
                            <small>
                                Extremely fast cookie clicking
                            </small>
                        </div>

                        <button
                            class="jeffyToggle"
                            id="jeffyAutoClick"
                        >
                            OFF
                        </button>
                    </div>


                    <div class="jeffyFeature">
                        <div>
                            <b>💰 0 Cost Buildings</b>
                            <small>
                                Makes every loaded building free
                            </small>
                        </div>

                        <button
                            class="jeffyToggle"
                            id="jeffyFree"
                        >
                            OFF
                        </button>
                    </div>


                    <div class="jeffyFeature">
                        <div>
                            <b>🛒 Auto Buy</b>
                            <small>
                                Automatically buys buildings
                            </small>
                        </div>

                        <button
                            class="jeffyToggle"
                            id="jeffyAutoBuy"
                        >
                            OFF
                        </button>
                    </div>


                    <div class="jeffyFeature">
                        <div>
                            <b>♾️ Infinite Heavenly Chips</b>
                            <small>
                                Sets Heavenly Chips to Infinity
                            </small>
                        </div>

                        <button
                            class="jeffyToggle"
                            id="jeffyHeavenly"
                        >
                            OFF
                        </button>
                    </div>


                    <div class="jeffyFeature">
                        <div>
                            <b>⭐ Cursor Level 10,000</b>
                            <small>
                                Sets Cursor level to 10000
                            </small>
                        </div>

                        <button
                            class="jeffyToggle on"
                            id="jeffyCursor"
                        >
                            ON
                        </button>
                    </div>


                    <div class="jeffyFeature">
                        <div>
                            <b>🏷️ Bakery Name</b>
                            <small>
                                Jeffy's Bakery
                            </small>
                        </div>
                    </div>


                    <div class="jeffyFeature">
                        <div>
                            <b>🗑 Destroy Hub</b>
                            <small>
                                Turns everything off and removes the hub
                            </small>
                        </div>

                        <button
                            class="jeffyDestroy"
                            id="jeffyDestroy"
                        >
                            DESTROY
                        </button>
                    </div>

                </div>


                <div id="jeffySettings"
                     style="display:none">

                    <div class="jeffySetting">
                        <span>Menu Key</span>

                        <button
                            class="jeffyKeyButton"
                            data-setting="menu"
                        >
                            P
                        </button>
                    </div>


                    <div class="jeffySetting">
                        <span>Auto Click Key</span>

                        <button
                            class="jeffyKeyButton"
                            data-setting="autoClick"
                        >
                            C
                        </button>
                    </div>


                    <div class="jeffySetting">
                        <span>0 Cost Key</span>

                        <button
                            class="jeffyKeyButton"
                            data-setting="free"
                        >
                            F
                        </button>
                    </div>


                    <div class="jeffySetting">
                        <span>Auto Buy Key</span>

                        <button
                            class="jeffyKeyButton"
                            data-setting="autoBuy"
                        >
                            B
                        </button>
                    </div>


                    <div class="jeffySetting">
                        <span>Heavenly Chips Key</span>

                        <button
                            class="jeffyKeyButton"
                            data-setting="heavenly"
                        >
                            H
                        </button>
                    </div>


                    <button
                        class="jeffyMusicButton"
                        id="jeffyMusic"
                    >
                        🎵 Calm Music: OFF
                    </button>


                    <div id="jeffyListening">
                        Click a key above to change its keybind.
                    </div>

                </div>

            </div>

            <div id="jeffyFooter">
                Press P to hide/show the hub
            </div>
        `;

        document.body.appendChild(hub);

        // ==========================================
        // HELPER
        // ==========================================

        function toggleButton(id, enabled) {

            const button =
                document.getElementById(id);

            if (!button) return;

            button.textContent =
                enabled ? "ON" : "OFF";

            button.classList.toggle(
                "on",
                enabled
            );
        }

        // ==========================================
        // 0 COST
        // ==========================================

        function makeFree() {

            if (!window.Game) return;

            if (!Game.ObjectsById) return;

            for (
                let i = 0;
                i < Game.ObjectsById.length;
                i++
            ) {

                const building =
                    Game.ObjectsById[i];

                if (!building) continue;

                building.price = 0;
                building.basePrice = 0;
                building.priceL = 0;
            }

            if (
                typeof Game.RefreshStore ===
                "function"
            ) {
                Game.RefreshStore();
            }
        }

        // ==========================================
        // AUTO BUY
        // ==========================================

        function autoBuy() {

            if (!window.Game) return;

            if (!Game.ObjectsById) return;

            for (
                let i = 0;
                i < Game.ObjectsById.length;
                i++
            ) {

                const building =
                    Game.ObjectsById[i];

                if (
                    building &&
                    typeof building.buy ===
                    "function"
                ) {
                    try {
                        building.buy();
                    } catch (e) {}
                }
            }
        }

        // ==========================================
        // INFINITE HEAVENLY CHIPS
        // ==========================================

        function infiniteHeavenlyChips() {

            if (!window.Game) return;

            Game.heavenlyChips = Infinity;
            Game.heavenlyChipsSpent = 0;

            if (!Game.prestige) {
                Game.prestige = {};
            }

            Game.prestige["Heavenly chips"] =
                Infinity;

            Game.prestige.ready = 1;

            Game.recalculateGains = 1;

            if (
                typeof Game.CalculateGains ===
                "function"
            ) {
                try {
                    Game.CalculateGains();
                } catch (e) {}
            }

            const display =
                document.querySelector(
                    "#ascendHCs .heavenly"
                );

            if (display) {
                display.textContent = "∞";
            }
        }

        // ==========================================
        // CURSOR LEVEL
        // ==========================================

        function cursorLevel() {

            if (!window.Game) return;

            if (
                !Game.ObjectsById ||
                !Game.ObjectsById[0]
            ) return;

            Game.ObjectsById[0].level = 10000;

            const display =
                document.getElementById(
                    "productLevel0"
                );

            if (display) {
                display.textContent =
                    "lvl 10000";
            }
        }

        // ==========================================
        // BAKERY NAME
        // ==========================================

        function bakeryName() {

            const name =
                document.getElementById(
                    "bakeryName"
                );

            if (name) {
                name.textContent =
                    "Jeffy's Bakery";
            }
        }

        // ==========================================
        // AUTO CLICK
        // ==========================================

        let clickLoop = null;

        function startAutoClick() {

            if (clickLoop) return;

            clickLoop = setInterval(() => {

                if (!state.autoClick)
                    return;

                const cookie =
                    document.getElementById(
                        "bigCookie"
                    );

                if (!cookie) return;

                for (
                    let i = 0;
                    i < 30;
                    i++
                ) {
                    try {
                        cookie.click();
                    } catch (e) {}
                }

            }, 1);
        }

        startAutoClick();

        // ==========================================
        // BUTTONS
        // ==========================================

        document.getElementById(
            "jeffyAutoClick"
        ).onclick = () => {

            state.autoClick =
                !state.autoClick;

            toggleButton(
                "jeffyAutoClick",
                state.autoClick
            );
        };


        document.getElementById(
            "jeffyFree"
        ).onclick = () => {

            state.free =
                !state.free;

            toggleButton(
                "jeffyFree",
                state.free
            );

            if (state.free) {
                makeFree();
            }
        };


        document.getElementById(
            "jeffyAutoBuy"
        ).onclick = () => {

            state.autoBuy =
                !state.autoBuy;

            toggleButton(
                "jeffyAutoBuy",
                state.autoBuy
            );
        };


        document.getElementById(
            "jeffyHeavenly"
        ).onclick = () => {

            state.heavenly =
                !state.heavenly;

            toggleButton(
                "jeffyHeavenly",
                state.heavenly
            );

            if (state.heavenly) {
                infiniteHeavenlyChips();
            }
        };


        document.getElementById(
            "jeffyCursor"
        ).onclick = () => {
            cursorLevel();
        };


        document.getElementById(
            "jeffyClose"
        ).onclick = () => {

            hub.classList.add("hidden");
        };


        // ==========================================
        // DESTROY
        // ==========================================

        document.getElementById(
            "jeffyDestroy"
        ).onclick = () => {

            state.destroyed = true;

            state.autoClick = false;
            state.free = false;
            state.autoBuy = false;
            state.heavenly = false;

            if (clickLoop) {
                clearInterval(clickLoop);
                clickLoop = null;
            }

            hub.remove();

            style.remove();

            if (window.JeffyHub) {
                window.JeffyHub.destroyed =
                    true;
            }
        };


        // ==========================================
        // TABS
        // ==========================================

        const farm =
            document.getElementById(
                "jeffyFarm"
            );

        const settings =
            document.getElementById(
                "jeffySettings"
            );

        hub.querySelectorAll(
            ".jeffyTab"
        ).forEach(tab => {

            tab.onclick = () => {

                hub.querySelectorAll(
                    ".jeffyTab"
                ).forEach(t => {
                    t.classList.remove(
                        "active"
                    );
                });

                tab.classList.add(
                    "active"
                );

                const isFarm =
                    tab.dataset.tab ===
                    "farm";

                farm.style.display =
                    isFarm
                        ? "block"
                        : "none";

                settings.style.display =
                    isFarm
                        ? "none"
                        : "block";
            };
        });


        // ==========================================
        // KEYBINDS
        // ==========================================

        hub.querySelectorAll(
            ".jeffyKeyButton"
        ).forEach(button => {

            const setting =
                button.dataset.setting;

            button.textContent =
                CONFIG.keys[setting]
                    .toUpperCase();

            button.onclick = () => {

                state.waitingForKey =
                    setting;

                button.textContent =
                    "...";

                document.getElementById(
                    "jeffyListening"
                ).textContent =
                    "Press a key now...";
            };
        });


        // ==========================================
        // MUSIC
        // ==========================================

        let music = null;
        let musicPlaying = false;

        if (CONFIG.musicURL) {

            music =
                new Audio(
                    CONFIG.musicURL
                );

            music.loop = true;

            music.volume = 0.15;

            music.id = "jeffyMusic";

            music.preload = "auto";

        }

        document.getElementById(
            "jeffyMusic"
        ).onclick = () => {

            if (!music) {

                alert(
                    "Add your royalty-free music URL to CONFIG.musicURL first."
                );

                return;
            }

            if (musicPlaying) {

                music.pause();

                musicPlaying = false;

                document.getElementById(
                    "jeffyMusic"
                ).textContent =
                    "🎵 Calm Music: OFF";

            } else {

                music.play().then(() => {

                    musicPlaying = true;

                    document.getElementById(
                        "jeffyMusic"
                    ).textContent =
                        "🎵 Calm Music: ON";

                }).catch(() => {

                    alert(
                        "Click the page once and try again."
                    );
                });
            }
        };


        // ==========================================
        // KEYBOARD
        // ==========================================

        document.addEventListener(
            "keydown",
            e => {

                if (state.destroyed)
                    return;

                if (
                    e.target &&
                    (
                        e.target.tagName ===
                        "INPUT" ||
                        e.target.tagName ===
                        "TEXTAREA"
                    )
                ) {
                    return;
                }

                const key =
                    e.key.toLowerCase();


                // Changing keybind
                if (state.waitingForKey) {

                    const setting =
                        state.waitingForKey;

                    CONFIG.keys[setting] =
                        key;

                    const button =
                        hub.querySelector(
                            `[data-setting="${setting}"]`
                        );

                    if (button) {
                        button.textContent =
                            key.toUpperCase();
                    }

                    state.waitingForKey =
                        null;

                    document.getElementById(
                        "jeffyListening"
                    ).textContent =
                        "Key changed to " +
                        key.toUpperCase();

                    e.preventDefault();

                    return;
                }


                // MENU
                if (
                    key === CONFIG.keys.menu
                ) {

                    hub.classList.toggle(
                        "hidden"
                    );

                    e.preventDefault();
                }


                // AUTO CLICK
                if (
                    key ===
                    CONFIG.keys.autoClick
                ) {

                    state.autoClick =
                        !state.autoClick;

                    toggleButton(
                        "jeffyAutoClick",
                        state.autoClick
                    );
                }


                // FREE
                if (
                    key === CONFIG.keys.free
                ) {

                    state.free =
                        !state.free;

                    toggleButton(
                        "jeffyFree",
                        state.free
                    );

                    if (state.free) {
                        makeFree();
                    }
                }


                // AUTO BUY
                if (
                    key ===
                    CONFIG.keys.autoBuy
                ) {

                    state.autoBuy =
                        !state.autoBuy;

                    toggleButton(
                        "jeffyAutoBuy",
                        state.autoBuy
                    );
                }


                // HEAVENLY
                if (
                    key ===
                    CONFIG.keys.heavenly
                ) {

                    state.heavenly =
                        !state.heavenly;

                    toggleButton(
                        "jeffyHeavenly",
                        state.heavenly
                    );

                    if (state.heavenly) {
                        infiniteHeavenlyChips();
                    }
                }

            }
        );


        // ==========================================
        // BACKGROUND / GAME SOUND MUTE
        // ==========================================

        function muteGameAudio() {

            document
                .querySelectorAll(
                    "audio,video"
                )
                .forEach(media => {

                    media.muted = true;
                    media.volume = 0;

                });

            if (window.Game) {

                try {
                    if (
                        Game.volume !==
                        undefined
                    ) {
                        Game.volume = 0;
                    }

                    if (
                        Game.volumeMusic !==
                        undefined
                    ) {
                        Game.volumeMusic = 0;
                    }

                    if (
                        Game.volumeSFX !==
                        undefined
                    ) {
                        Game.volumeSFX = 0;
                    }
                } catch (e) {}
            }
        }


        // ==========================================
        // GAME LOOP
        // ==========================================

        const gameLoop =
            setInterval(() => {

                if (state.destroyed) {
                    clearInterval(gameLoop);
                    return;
                }

                muteGameAudio();

                bakeryName();

                cursorLevel();

                if (state.free) {
                    makeFree();
                }

                if (state.autoBuy) {
                    autoBuy();
                }

                if (state.heavenly) {
                    infiniteHeavenlyChips();
                }

            }, 100);


        // ==========================================
        // COOKIE GIF
        // ==========================================

        const cookie =
            document.getElementById(
                "bigCookie"
            );

        if (cookie) {

            cookie.style.backgroundImage =
                "url('https://i.kym-cdn.com/photos/images/newsfeed/002/955/803/56d.gif')";

            cookie.style.backgroundSize =
                "cover";

            cookie.style.backgroundPosition =
                "center";

            cookie.style.backgroundRepeat =
                "no-repeat";

            cookie.style.borderRadius =
                "50%";
        }


        // ==========================================
        // PUBLIC CONTROL
        // ==========================================

        window.JeffyHub = {

            destroyed: false,

            destroy() {

                state.destroyed = true;

                if (clickLoop) {
                    clearInterval(
                        clickLoop
                    );
                }

                hub.remove();

                style.remove();

                if (overlay) {
                    overlay.remove();
                }
            }
        };
    }

})();
