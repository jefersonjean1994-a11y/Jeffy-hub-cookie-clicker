            box-sizing: border-box;

            padding: 12px;

            text-align: center;

            background: rgba(0,0,0,.48);

            border-top:
                1px solid rgba(190,60,230,.3);

            color: #888;

            font-size: 13px;
        }

        .jeffyMusicButton {
            width: 100%;

            padding: 13px;

            margin-bottom: 12px;

            border:
                1px solid #8c32aa;

