            margin-bottom: 11px;

            background: rgba(4,4,7,.54);

            border:
                1px solid rgba(180,60,220,.32);

            border-radius: 14px;

            font-size: 17px;
        }

        .jeffyKeyButton {
            min-width: 72px;

            padding: 10px 14px;

            border:
                1px solid #8c32aa;

            border-radius: 10px;

            background: rgba(0,0,0,.55);

            color: #df82ff;

            font-weight: bold;

            cursor: pointer;
        }

        #jeffyListening {
            padding: 13px;

